# Optional local overrides. Never commit real credentials.
TRADING_PLATFORM_CONFIG=config/platform.example.toml
TRADING_PLATFORM_LOG_LEVEL=INFO
# Optional. A read-only/restricted KuCoin API key only.
# These placeholders must remain placeholders; never commit real credentials.
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# --- Phase 2: BNB Smart Chain read-only integration (no secrets; never commit real keys) ---
# Any BSC RPC endpoint (public or your own node). No paid endpoint is required or assumed.
BSC_RPC_URL=
# BSC_RPC_TIMEOUT_SECONDS=10
# BSC_RPC_MAX_RETRIES=2
# BSC_MAX_BLOCK_AGE_SECONDS=30
# Optional PUBLIC address used only as `from` for local eth_estimateGas Router simulation. Never a private key.
# It needs native BNB for gas and the route input token; ERC-20 input routes also need an existing Router allowance.
# No approval, signing, or transaction submission is performed.
# BSC_GAS_SIMULATION_FROM=
